  "info": {
    "title": "MyTodo API",
    "description": "Synchronization and reminder API for MyTodo clients",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "WINDOWS",
              "MACOS",
              "WEB"
            ],
            "example": "WINDOWS"
          },
          "deviceName": {
            "type": "string",
            "example": "书房电脑"
          }
        },
        "required": [
          "platform",
          "deviceName"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "AccountRegistrationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "platform": {
            "type": "string",
            "enum": [
              "WINDOWS",
              "MACOS",
              "WEB",
              "ANDROID",
              "IOS"
            ],
            "example": "WINDOWS"
          },
          "deviceName": {
            "type": "string",
            "example": "书房电脑"
          }
        },
        "required": [
          "email",
          "password",
          "code",
          "platform",
          "deviceName"
        ]
      },
      "AccountLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "platform": {
            "type": "string",
            "enum": [
              "WINDOWS",
              "MACOS",
              "WEB",
              "ANDROID",
              "IOS"
            ],
            "example": "WINDOWS"
          },
          "deviceName": {
            "type": "string",
            "example": "书房电脑"
          }
        },
        "required": [
          "email",
          "password",
          "platform",
          "deviceName"
        ]
      },
      "BindEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "avatarPreset": {
            "type": "string",
            "enum": [
              "indigo",
              "emerald",
              "rose",
              "amber",
              "slate"
            ]
          }
        }
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "password"
        ]
      },
      "AccountCodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "code"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "code",
          "newPassword"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "deviceId",
          "refreshToken"
        ]
      },
      "RecoverAccountDto": {
        "type": "object",
        "properties": {
          "recoveryKey": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "WINDOWS",
              "MACOS",
              "WEB",
              "ANDROID",
              "IOS"
            ]
          },
          "deviceName": {
            "type": "string",
            "example": "新电脑"
          }
        },
        "required": [
          "recoveryKey",
          "platform",
          "deviceName"
        ]
      },
      "CreatePairingSessionDto": {
        "type": "object",
        "properties": {
          "targetPlatform": {
            "type": "string",
            "enum": [
              "ANDROID",
              "IOS"
            ]
          },
          "targetDeviceName": {
            "type": "string",
            "example": "我的手机"
          }
        },
        "required": [
          "targetPlatform"
        ]
      },
      "ClaimPairingSessionDto": {
        "type": "object",
        "properties": {
          "claimToken": {
            "type": "string",
            "description": "Opaque token read from the QR code"
          },
          "manualCode": {
            "type": "string",
            "description": "Six-digit fallback code"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ANDROID",
              "IOS"
            ]
          },
          "deviceName": {
            "type": "string",
            "example": "Android 手机"
          }
        },
        "required": [
          "platform",
          "deviceName"
        ]
      },
      "PushSyncDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}